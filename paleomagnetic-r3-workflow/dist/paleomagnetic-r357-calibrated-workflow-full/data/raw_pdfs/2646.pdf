         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Geomagnetism and Paleomagnetism: Rock and mineral magnetism; Tectonophysics: Plate motions, past and present</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism and geochronology of 23 Ma gabbroic intrusions in the Keku Strait, Alaska, and implications for the Alexander Terrane</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Peter J. Haeussler, Robert S. Coe, Paul Renne</rdf:li>
            </rdf:Seq>
