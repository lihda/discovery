<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04        " xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Information Related to Geologic Time: Paleozoic; Information Related to Geographic Region: Asia; Geomagnetism and Paleomagnetism: Reversals (process, time scale, magnetostratigraphy); Tectonophysics: Continental tectonics; Tectonophysics: Plate motions, past and present</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A Devonian paleomagnetic pole from red beds of the Tarim Block, China</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Yianping Li, Michael McWillams, Robert Sharps, Allan Cox, Yongan Li, Qiang Li, Zhengjia Gao, Zhengkun Zhang, Yongjian Zhai</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
