      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Tectonophysics: Continental tectonics; Tectonophysics: Plate motions, past and present</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of Jurassic volcanic rocks in the Patagonia Mountains, southeastern Arizona: Implications for the North American 170 Ma reference pole</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Steven R. May, Robert F. Butler, Muhammad Shafiqullah, Paul E. Damon</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
