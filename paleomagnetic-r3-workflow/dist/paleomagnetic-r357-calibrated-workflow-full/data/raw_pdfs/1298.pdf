      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of the Tertiary Clarno Formation of central Oregon and its significance for the tectonic history of the Pacific Northwest</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>C. Sherman Gromme, Myrl E. Beck, Ray E. Wells, David C. Engebretson</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
