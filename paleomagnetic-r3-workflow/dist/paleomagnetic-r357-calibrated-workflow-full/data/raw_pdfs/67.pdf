      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Earth&amp;apos;s Main Magnetic Field (Geomagnetic Field): Time variations, paleomagnetism; Geochemistry: Geochronology (age determinations by radioactive processes); Tectonophysics: Structure of the crust; Information Related to Geographic Regions: Africa</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tectonic history of the Ethiopian Rift as deduced by K-Ar ages and paleomagnetic measurements of basaltic dikes</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>G. H. Megrue, E. Norton, D. W. Strangway</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>http://dx.doi.org/10.1029/JB077i029p05744, doi:10.1029/JB077i029p05744, Ethiopia, Igneous Rocks, Paleomagnetism, Tectonics</pdf:Keywords>
