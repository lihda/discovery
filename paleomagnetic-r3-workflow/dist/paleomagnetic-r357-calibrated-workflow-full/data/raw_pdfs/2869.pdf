      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Geomagnetism and Paleomagnetism: Rock and mineral magnetism; Tectonophysics: Plate motions, past and present; Tectonophysics: Structural geology (crustal structure and mechanics)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Rotated paleomagnetic poles from the Sassamansville syncline, Newark basin, southeastern Pennsylvania</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>K. P. Kodama, C. Hedlund, J. Gosse, J. Strasser</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
