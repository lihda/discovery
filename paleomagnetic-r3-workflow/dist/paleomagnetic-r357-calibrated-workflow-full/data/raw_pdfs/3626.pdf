            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Magnetic mineralogy and petrology; Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes; Geomagnetism and Paleomagnetism: Remagnetization; Tectonophysics: Plate motions&amp;mdash;past; Information Related to Geologic Time: Paleozoic</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetic results from the Cambrian and Ordovician sediments of Bornholm (Denmark) and Southern Sweden and paleogeographical implications for Baltica</rdf:li>
