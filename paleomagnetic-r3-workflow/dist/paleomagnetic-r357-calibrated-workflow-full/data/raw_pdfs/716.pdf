         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of the Haliburton Intrusions: Superimposed magnetizations, metamorphism, and tectonics in the Late Precambrian</rdf:li>
            </rdf:Alt>
         </dc:title>
