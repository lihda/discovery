         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics (regional, global); Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes; Geomagnetism and Paleomagnetism: Reference fields (regional, global)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A Late Cretaceous paleomagnetic pole from Koto rhyolite, southwest Japan: Implications for eastern margin deformation of Asia</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Koji Fukuma, Hisashi Tsurudome, Masayuki Torii</rdf:li>
