      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Magnetic fabrics and anisotropy; Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics (regional, global); Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes; Geomagnetism and Paleomagnetism: Remagnetization; Tectonophysics: Plate motions&amp;mdash;past</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Apparent polar wander paths and the close of late Archean crustal transpression, northern Ontario</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>G. J. Borradaile, T. J. Lemmetty, T. Werner</rdf:li>
            </rdf:Seq>
         </dc:creator>
