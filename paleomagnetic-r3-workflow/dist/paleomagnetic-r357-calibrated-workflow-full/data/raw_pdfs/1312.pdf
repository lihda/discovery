         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Tectonophysics: Plate boundary structures and processes; Tectonophysics: Plate motions, past and present; Information Related to Geographic Region: North America</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Multicomponent paleomagnetic data from the Nosoni Formation, eastern Klamath Mountains, California: Cratonic Permian primary directions with Jurassic overprints</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Paul R. Renne, Gary R. Scott, David R. Bazard</rdf:li>
            </rdf:Seq>
