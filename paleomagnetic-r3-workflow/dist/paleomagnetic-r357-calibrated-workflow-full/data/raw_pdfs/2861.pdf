            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Information Related to Geologic Time: Mesozoic; Tectonophysics: Plate motions, past and present; Information Related to Geographic Region: Asia; Tectonophysics: Evolution of the earth</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Cretaceous paleomagnetic results from western Tibet and tectonic implications</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
