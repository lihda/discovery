         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Geomagnetism and Paleomagnetism: Rock and mineral magnetism; Information Related to Geographic Region: Asia; Information Related to Geologic Time: Precambrian</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Chemical remanent magnetism related to the Dead Sea Rift: Evidence from Precambrian igneous rocks of Mount Timna, southern Israel</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
