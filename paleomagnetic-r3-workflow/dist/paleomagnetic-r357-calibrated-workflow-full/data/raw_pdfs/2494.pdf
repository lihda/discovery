            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tectonic implications of a remagnetization event in the Newark Basin</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
