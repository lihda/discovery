         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Rock and mineral magnetism; Tectonophysics: Hydrothermal systems; Marine Geology and Geophysics: Midocean ridge processes; Geomagnetism and Paleomagnetism: Spatial variations attributed to sea floor spreading</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of the Moreton's Harbour Group, northeastern Newfoundland Appalachians: Evidence for an Early Ordovician Island Arc near the Laurentian Margin of Iapetus</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Rex J. E. Johnson, Ben A. van der Pluijm, Rob Van der Voo</rdf:li>
            </rdf:Seq>
