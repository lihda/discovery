            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Information Related to Geologic Time: Mesozoic; Information Related to Geographic Region: North America; Geomagnetism and Paleomagnetism: Paleomagnetic secular variation; Geomagnetism and Paleomagnetism: Time variations, secular and long term; History of Geophysics: Geomagnetism and paleomagnetism</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Mid-Cretaceous paleomagnetic reference field for North America: Restudy of 100 Ma intrusive rocks from Arkansas</rdf:li>
            </rdf:Alt>
