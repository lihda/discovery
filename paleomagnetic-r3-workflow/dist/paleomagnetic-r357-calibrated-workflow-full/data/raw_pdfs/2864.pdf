         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Geomagnetism and Paleomagnetism: Rock and mineral magnetism; Mineralogy, Petrology, and Rock Chemistry: Mineral occurrences and deposits; Information Related to Geographic Region: North America; Tectonophysics: Hydrothermal systems</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of the Mississippi Valley-type Newfoundland zinc deposit: Evidence for Devonian mineralization and host rock remagnetization in the northern Appalachians</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
