         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Information Related to Geographic Region: North America; Geomagnetism and Paleomagnetism: Paleomagnetic secular variation; Geomagnetism and Paleomagnetism: Time variations, secular and long term; Tectonophysics: Plate motions, past and present</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">On determining paleohorizontal and latitudinal shifts: Paleomagnetism of Spences Bridge Group, British Columbia</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>E. Irving, D. J. Thorkelson</rdf:li>
            </rdf:Seq>
         </dc:creator>
