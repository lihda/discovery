<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04        " xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics (regional, global); Tectonophysics: Continental contractional orogenic belts; Tectonophysics: Continental tectonics&amp;mdash;general</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism indicates no Neogene vertical axis rotations of the northeastern Tibetan Plateau</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Guillaume Dupont-Nivet, Robert F. Butler, An Yin, Xuanhua Chen</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>http://dx.doi.org/10.1029/2003JB002399, doi:10.1029/2003JB002399</pdf:Keywords>
         <pdf:Producer>PDFlib PLOP 2.0.0p6 (SunOS)/Acrobat Distiller 4.05 for Windows; modified using iText 4.2.0 by 1T3XT</pdf:Producer>
