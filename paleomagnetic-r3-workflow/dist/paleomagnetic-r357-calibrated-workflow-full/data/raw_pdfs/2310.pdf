      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tectonophysics: Structural geology (crustal structure and mechanics); Geomagnetism and Paleomagnetism: Time variations, secular and long term; Information Related to Geologic Time: Mesozoic; Information Related to Geographic Region: North America; Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetic evidence for Post-Jurassic stability of southeastern Mexico: Maya Terrane</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jose C. Guerrero, Emilio Herrero-Bervera, Charles E. Helsley</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
