<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04        " xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Core processes; Geomagnetism and Paleomagnetism: Magnetostratigraphy; Geomagnetism and Paleomagnetism: Reversals (process, timescale, magnetostratigraphy); Geomagnetism and Paleomagnetism: Time variations&amp;mdash;secular and long term</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Upper Anisian to Lower Carnian magnetostratigraphy from the Northern Calcareous Alps (Austria)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Yves Gallet, Leopold Krystyn, Jean Besse</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
