         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetic and petrographic evidence for early magnetizations in successive Terra Rosa Paleosols, Lower Pennsylvanian black prince limestone, Arizona</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Kevin Nick, Kedong Xia, R. D. Elmore</rdf:li>
            </rdf:Seq>
         </dc:creator>
