         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes; Geomagnetism and Paleomagnetism: Magnetic fabrics and anisotropy; Tectonophysics: Continental neotectonics; Information Related to Geographic Region: Pacific Ocean</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetic evidence for rapid vertical-axis rotations during thrusting in an active collision zone, northeastern Papua New Guinea</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
