      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Tectonophysics: Continental tectonics; Tectonophysics: Structural geology (crustal structure and mechanics)</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of the structurally deformed Latir volcanic field, northern New Mexico: Relations to formation of the Questa caldera and development of the Rio Grande rift</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jonathan T. Hagstrum, Peter W. Lipman</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
