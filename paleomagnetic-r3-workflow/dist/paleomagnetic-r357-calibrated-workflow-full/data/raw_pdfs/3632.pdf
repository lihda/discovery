<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04        " xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics (regional, global); Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes; Geomagnetism and Paleomagnetism: Remagnetization; Geomagnetism and Paleomagnetism: Rock and mineral magnetism</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">New paleomagnetic, rock magnetic, and petrographic results from the Valle Group, Baja California, Mexico: Exploring the causes of anomalously shallow paleomagnetic inclinations</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Yong&amp;hyphen;Xiang Li, Kenneth P. Kodama, Douglas P. Smith</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>http://dx.doi.org/10.1029/2004JB003127, doi:10.1029/2004JB003127, paleomagnetism, shallow inclination, Valle, Baja California, remagnetization, Cretaceous</pdf:Keywords>
