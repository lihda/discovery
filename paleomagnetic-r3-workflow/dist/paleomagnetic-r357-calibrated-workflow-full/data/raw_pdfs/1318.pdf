         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Geomagnetism and Paleomagnetism: Rock and mineral magnetism; Tectonophysics: Structural geology (crustal structure and mechanics); Information Related to Geographic Region: Europe</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">STRAIN, MAGNETIC FABRIC, AND PALEOMAGNETISM OF THE DEFORMED RED BEDS OF THE PONT-REAN FORMATION, BRITTANY, FRANCE</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jean-Pascal Cogn&amp;#233;</rdf:li>
            </rdf:Seq>
