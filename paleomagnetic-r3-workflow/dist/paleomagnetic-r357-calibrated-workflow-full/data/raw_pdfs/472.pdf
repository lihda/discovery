         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Earth&amp;apos;s Main Magnetic Field (Geomagnetic Field): Spatial variation (all harmonics and anomalies); Earth&amp;apos;s Main Magnetic Field (Geomagnetic Field): Time variations, paleomagnetism; Earth&amp;apos;s Main Magnetic Field (Geomagnetic Field): Time variations, diurnal to secular; Information Related to Geologic Time: Cenozoic; Information Related to Geographic Regions: Indian Ocean</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of R&amp;#233;union Island and its bearing on secular variation</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>F. H. Chamalaun</rdf:li>
            </rdf:Seq>
         </dc:creator>
