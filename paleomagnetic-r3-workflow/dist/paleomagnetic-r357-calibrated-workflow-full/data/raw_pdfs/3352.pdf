      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics (regional, global); Geomagnetism and Paleomagnetism: Remagnetization; Information Related to Geographic Region: Asia; Information Related to Geologic Time: Mesozoic</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism, rock magnetism, and fission track dating of the Kurihashi Granodiorite in northeast Japan: Evidence for a Cretaceous hydrothermal event and differential rotation along the eastern Eurasian margin</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Y. Itoh, K. Amano, T. Danhara</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
