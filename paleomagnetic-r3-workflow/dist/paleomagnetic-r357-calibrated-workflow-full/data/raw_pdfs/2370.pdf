         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Geomagnetism and Paleomagnetism: Rock and mineral magnetism; History of Geophysics: Geomagnetism and paleomagnetism; Tectonophysics: Plate motions, past and present</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A new Late Cretaceous paleomagnetic pole from the Adel Mountains, west central Montana</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jay A. Gunderson, Steven D. Sheriff</rdf:li>
            </rdf:Seq>
