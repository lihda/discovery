         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Earth&amp;apos;s Main Magnetic Field (Geomagnetic Field): Time variations, paleomagnetism; Mineralogy, Petrology, and Physical Properties of Rocks: Magnetic and electrical properties; Information Related to Geologic Time: Cenozoic; Information Related to Geographic Regions: North America</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Remanent magnetization, cooling history, and paleomagnetic record of the Marys Peak Sill, Oregon</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>H. C. Clark</rdf:li>
            </rdf:Seq>
         </dc:creator>
