<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04        " xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Earth&amp;apos;s Main Magnetic Field (Geomagnetic Field): Time variations, diurnal to secular; Mineralogy, Petrology, and Physical Properties of Rocks: Magnetic and electrical properties; Information Related to Geologic Time: Precambrian; Information Related to Geographic Regions: North America</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Paleomagnetism of 1140 to 1150 million-year diabase sills from Gila County, Arizona</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Charles E. Helsley, Henry Spall</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>http://dx.doi.org/10.1029/JB077i011p02115, doi:10.1029/JB077i011p02115, Arizona, Igneous Rocks, Intrusions, Paleomagnetism, Precambrian</pdf:Keywords>
         <pdf:Producer>PDFlib PLOP 2.0.0p6 (SunOS)/escape 1.1; modified using iText 4.2.0 by 1T3XT</pdf:Producer>
      </rdf:Description>
