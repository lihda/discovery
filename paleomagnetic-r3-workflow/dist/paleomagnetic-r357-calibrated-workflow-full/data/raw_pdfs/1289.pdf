         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geomagnetism and Paleomagnetism: Paleomagnetic secular variation; Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; Geomagnetism and Paleomagnetism: Rock and mineral magnetism; Tectonophysics: Continental tectonics</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tectonic implications of paleomagnetic poles from Lower Tertiary Volcanic Rocks, south central Alaska</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>John W. Hillhouse, C. Sherman Gromm&amp;#233;, Bela Csejtey</rdf:li>
            </rdf:Seq>
