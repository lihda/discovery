  "title": {
    "en": "Calibrated ROCKMAG-equivalent practice criterion for R3",
    "zh": "R3 的校准 ROCKMAG 等价实践判据"
  },
  "provenance": {
    "derivation": {
      "en": "The normative R3 source, the label-independent ROCKMAG practice criterion, aggregate ROCKMAG terminology, and REFNO-grouped development results were used to calibrate a historical-label compatibility policy.",
      "zh": "使用规范 R3 原文、标签无关的 ROCKMAG 实践判据、ROCKMAG 聚合术语以及按 REFNO 分组的开发结果，校准历史标签兼容策略。"
    },
    "label_supervision": true,
    "rockmag_field_supervision": true,
    "evaluation_results_used": true,
    "contains_record_identifiers": false,
    "contains_record_answer_mapping": false,
    "contains_raw_rockmag_values": false,
    "contains_source_paper_quotes": false,
    "independent_external_validation": false
  },
