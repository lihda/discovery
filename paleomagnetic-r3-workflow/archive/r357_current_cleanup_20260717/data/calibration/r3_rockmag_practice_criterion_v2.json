      "role": "positive_rockmag_semantic_families"
    }
  ],
  "semantic_revision": {
    "previous_requirement": {
      "operator": "all",
      "facets": [
        "eligible_characterization_method",
        "carrier_identification",
        "remanence_significance_interpretation"
      ]
    },
    "revised_requirement": {
      "operator": "any",
      "routes": [
        "performed_eligible_characterization",
        "self_authenticating_diagnostic_result",
        "explicit_carrier_attribution"
      ]
    },
    "not_required_for_historical_practice_positive": [
      "explicit_carrier_identification_after_every_method",
      "explicit_remanence_significance_interpretation"
    ],
    "statement": {
      "en": "Historical R3 compatibility asks whether the original paper contains an attributable episode that could reasonably populate a ROCKMAG description, rather than requiring the complete normative scientific chain.",
      "zh": "历史 R3 兼容性判断关注原文中是否存在可合理形成 ROCKMAG 描述的可归属片段，而不再强制完整的规范科学证据链。"
    }
  },
  "evidence_routes": [
    {
      "route_id": "R3.PRACTICE.ROUTE.PERFORMED_METHOD",
      "requires_all": [
        "original_paper_context",
        "eligible_method_family",
        "performed_or_reported_context",
        "scope_attributable"
      ],
      "examples_of_families": [
        "IRM_or_SIRM_acquisition",
        "thermomagnetic_or_Js_T_curve",
        "temperature_dependent_susceptibility",
        "three_axis_or_low_temperature_IRM",
        "hysteresis_FORC_or_coercivity",
        "petrography_or_microanalysis",
        "mineral_phase_analysis"
      ]
    },
    {
      "route_id": "R3.PRACTICE.ROUTE.SELF_AUTHENTICATING_RESULT",
      "requires_all": [
        "original_paper_context",
        "diagnostic_result_entails_measurement",
        "scope_attributable"
      ],
      "examples": [
        "saturation_or_non_saturation_field",
        "Curie_or_transition_temperature",
        "coercivity_or_hysteresis_parameter",
        "domain_state_or_grain_size_result",
        "mineral_transition_or_phase_result"
      ]
    },
    {
      "route_id": "R3.PRACTICE.ROUTE.CARRIER_ATTRIBUTION",
      "requires_all": [
        "original_paper_context",
        "carrier_explicitly_linked_to_remanence_or_component",
        "scope_attributable"
      ],
      "examples": [
        "component_carried_by_hematite",
        "remanence_resides_in_magnetite",
        "magnetization_attributed_to_titanomagnetite"
      ]
    }
  ],
  "exclusions": [
    "reference_or_bibliography_only",
    "citation_only_or_external_study",
    "negated_hypothetical_future_or_recommended_method",
    "ordinary_demagnetization_temperature_interval_without_independent_characterization",
    "bare_SUSC_code_without_measurement_context",
    "bare_AN_code_without_unambiguous_fabric_measurement",
    "bare_mineral_name_without_method_diagnostic_or_remanence_attribution"
  ],
  "scope_policy": {
    "resolution_order": [
      "target_bound_episode",
      "explicit_shared_sample_episode",
      "single_target_paper_episode"
    ],
    "single_target_paper": "paper-level eligible evidence is attributable to the only target",
    "multi_target_paper": "paper-level propagation is forbidden unless a shared sample scope is explicit",
    "ambiguous_scope": "ABSTAIN"
  },
  "decision_policy": {
    "model_output": "historical_practice_probability",
    "full_coverage_reference_threshold": 0.5,
    "selective_policy": {
      "DOES_NOT_MEET_PRACTICE_PROXY": {
        "maximum_probability": 0.3
      },
      "MEETS_PRACTICE_PROXY": {
        "minimum_probability": 0.7
      },
      "ABSTAIN": {
        "minimum_exclusive_probability": 0.3,
        "maximum_exclusive_probability": 0.7
      },
      "SKIP_NO_SOURCE": "original PDF unavailable"
    },
    "probability_contract": {
      "required_range": [0.0, 1.0],
      "required_training_isolation": "REFNO_grouped",
      "required_runtime_inputs": [
        "identity_manifest_REFNO_RESULTNO_ROCKNAME",
        "original_paper_text",
        "frozen_expert_knowledge",
        "frozen_model_package"
      ]
    }
  },
  "dual_head_conflict_policy": {
    "normative_head": "complete scientific R3 evidence chain",
    "historical_practice_head": "this calibrated ROCKMAG-equivalent criterion",
    "practice_positive_normative_incomplete": "HISTORICAL_PRACTICE_POSITIVE_NORMATIVE_CHAIN_INCOMPLETE",
    "practice_negative_normative_positive": "HISTORICAL_PRACTICE_NEGATIVE_NORMATIVE_CONFLICT",
    "either_head_abstains": "UNRESOLVED"
  },
